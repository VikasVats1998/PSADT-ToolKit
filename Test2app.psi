#requires -Version 5.1
<#
    HelpDesk-Maintenance.Functions.ps1
    Backend logic for the LZFD Karlsruhe IT Help Desk maintenance tool.
    Dot-source this from your PSADT session, then call the functions from your UI event handlers.
    Every function returns [pscustomobject]@{ Success = $bool; Message = $string; ... }.
#>

Add-Type -AssemblyName System.DirectoryServices.AccountManagement

#region ---------- Configuration (EDIT THESE) ----------

# Map the "Chose Domain Number" (1-4) to real FQDNs.
function Resolve-HelpDeskDomain {
    param([Parameter(Mandatory)][int]$DomainNumber)
    switch ($DomainNumber) {
        1       { 'dom1.example.local' }
        2       { 'dom2.example.local' }
        3       { 'dom3.example.local' }
        4       { 'dom4.example.local' }
        default { $null }
    }
}

# Predefined registry targets shown in the numbered list.
#  - Hive:  'HKEY_LOCAL_MACHINE' or 'HKEY_USERS'
#  - Path:  subkey path (no leading backslash)
#  - Name:  value name -> deletes a VALUE. Empty/'' -> deletes the whole KEY (recursive).
$script:RegistryTargets = @(
    [pscustomobject]@{ Index = 1; Label = 'Example App Cache';   Hive = 'HKEY_LOCAL_MACHINE'; Path = 'SOFTWARE\ExampleApp\Cache';    Name = '' }
    [pscustomobject]@{ Index = 2; Label = 'Broken Policy Value';  Hive = 'HKEY_LOCAL_MACHINE'; Path = 'SOFTWARE\ExampleApp';          Name = 'BadPolicy' }
    [pscustomobject]@{ Index = 3; Label = 'Stale Profile Key';    Hive = 'HKEY_LOCAL_MACHINE'; Path = 'SOFTWARE\ExampleApp\Profiles';  Name = '' }
    [pscustomobject]@{ Index = 4; Label = 'Legacy Add-in';        Hive = 'HKEY_LOCAL_MACHINE'; Path = 'SOFTWARE\Vendor\Addin';        Name = '' }
    [pscustomobject]@{ Index = 5; Label = 'User Autostart Value'; Hive = 'HKEY_USERS';         Path = '<SID>\SOFTWARE\...';           Name = 'Runonce' }
)

#endregion

#region ---------- Logging (uses PSADT if available) ----------

function Write-HelpDeskLog {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('Info','Warning','Error')][string]$Severity = 'Info'
    )
    if (Get-Command Write-ADTLogEntry -ErrorAction Ignore) {
        $sev = switch ($Severity) { 'Warning' { 2 } 'Error' { 3 } default { 1 } }
        Write-ADTLogEntry -Message $Message -Severity $sev -Source 'HelpDeskMaintenance'
    }
    else {
        $line = "[{0}] [{1}] {2}" -f (Get-Date -Format 'HH:mm:ss'), $Severity, $Message
        if ($Severity -eq 'Error') { Write-Host $line -ForegroundColor Red }
        elseif ($Severity -eq 'Warning') { Write-Host $line -ForegroundColor Yellow }
        else { Write-Host $line }
    }
}

#endregion

#region ---------- 1. Domain authentication (the "Analyzing" screen) ----------

function New-HelpDeskCredential {
    # Build a PSCredential from the UI fields. $Password is a SecureString from your password box.
    param(
        [Parameter(Mandatory)][int]$DomainNumber,
        [Parameter(Mandatory)][string]$User,
        [Parameter(Mandatory)][securestring]$Password
    )
    $fqdn = Resolve-HelpDeskDomain -DomainNumber $DomainNumber
    if (-not $fqdn) {
        return [pscustomobject]@{ Success = $false; Message = "Unknown domain number: $DomainNumber"; Credential = $null; Domain = $null }
    }
    $upn = if ($User -match '[\\@]') { $User } else { "$User@$fqdn" }
    $cred = [System.Management.Automation.PSCredential]::new($upn, $Password)
    [pscustomobject]@{ Success = $true; Message = 'Credential built'; Credential = $cred; Domain = $fqdn }
}

function Test-HelpDeskCredential {
    param(
        [Parameter(Mandatory)][string]$DomainFqdn,
        [Parameter(Mandatory)][pscredential]$Credential
    )
    try {
        $plain = $Credential.GetNetworkCredential().Password
        $sam   = $Credential.GetNetworkCredential().UserName
        $ctx   = [System.DirectoryServices.AccountManagement.PrincipalContext]::new(
                    [System.DirectoryServices.AccountManagement.ContextType]::Domain, $DomainFqdn)
        $valid = $ctx.ValidateCredentials($sam, $plain)
        $plain = $null   # drop plaintext ASAP
        if ($valid) {
            Write-HelpDeskLog "Authenticated $sam against $DomainFqdn" 'Info'
            [pscustomobject]@{ Success = $true;  Message = "Authenticated against $DomainFqdn" }
        }
        else {
            Write-HelpDeskLog "Authentication failed for $sam against $DomainFqdn" 'Warning'
            [pscustomobject]@{ Success = $false; Message = 'Invalid username or password.' }
        }
    }
    catch {
        Write-HelpDeskLog "Auth error: $($_.Exception.Message)" 'Error'
        [pscustomobject]@{ Success = $false; Message = "Domain not reachable: $($_.Exception.Message)" }
    }
}

#endregion

#region ---------- 2. Connect to the remote PC (the "Connect" screen) ----------

function Test-HelpDeskRemoteConnection {
    param(
        [Parameter(Mandatory)][string]$ComputerName,
        [Parameter(Mandatory)][pscredential]$Credential
    )
    if (-not (Test-Connection -ComputerName $ComputerName -Count 1 -Quiet)) {
        Write-HelpDeskLog "$ComputerName did not respond to ping." 'Warning'
        # not fatal (ICMP may be blocked) — fall through to the real WinRM test
    }
    try {
        $name = Invoke-Command -ComputerName $ComputerName -Credential $Credential `
                    -ScriptBlock { $env:COMPUTERNAME } -ErrorAction Stop
        Write-HelpDeskLog "WinRM session OK to $name" 'Info'
        [pscustomobject]@{ Success = $true; Message = "Connected to $name" }
    }
    catch {
        Write-HelpDeskLog "Connect failed to $ComputerName : $($_.Exception.Message)" 'Error'
        [pscustomobject]@{ Success = $false; Message = "Cannot reach $ComputerName over WinRM: $($_.Exception.Message)" }
    }
}

#endregion

#region ---------- 3. Read the registry keys (the "Read" screen -> numbered list) ----------

function Get-HelpDeskRegistryData {
    param(
        [Parameter(Mandatory)][string]$ComputerName,
        [Parameter(Mandatory)][pscredential]$Credential
    )
    try {
        $data = Invoke-Command -ComputerName $ComputerName -Credential $Credential -ErrorAction Stop `
            -ArgumentList (,$script:RegistryTargets) -ScriptBlock {
                param($Targets)
                foreach ($t in $Targets) {
                    $full = "Registry::$($t.Hive)\$($t.Path)"
                    $exists = $false; $value = $null; $type = 'Key'
                    if ([string]::IsNullOrWhiteSpace($t.Name)) {
                        # whole-key target
                        $exists = Test-Path -LiteralPath $full
                    }
                    else {
                        # value target
                        $type = 'Value'
                        try {
                            $value  = Get-ItemPropertyValue -LiteralPath $full -Name $t.Name -ErrorAction Stop
                            $exists = $true
                        } catch { $exists = $false }
                    }
                    [pscustomobject]@{
                        Index = $t.Index; Label = $t.Label; Type = $type
                        Target = "$($t.Hive)\$($t.Path)$(if($t.Name){" :: $($t.Name)"})"
                        Exists = $exists; Value = $value
                    }
                }
            }
        # log the pre-deletion snapshot (safety record)
        foreach ($row in $data) {
            Write-HelpDeskLog ("READ [{0}] {1} | Exists={2} | Value={3}" -f $row.Index,$row.Target,$row.Exists,$row.Value) 'Info'
        }
        [pscustomobject]@{ Success = $true; Message = 'Registry read complete'; Items = ($data | Sort-Object Index) }
    }
    catch {
        Write-HelpDeskLog "Read failed on $ComputerName : $($_.Exception.Message)" 'Error'
        [pscustomobject]@{ Success = $false; Message = "Read failed: $($_.Exception.Message)"; Items = @() }
    }
}

#endregion

#region ---------- 4. Delete selected keys (the "Select the Numbers: 2,4,5" screen) ----------

function ConvertTo-HelpDeskIndexList {
    # "2,4,5" (or "2 4 5") -> validated int[] against the target list
    param([Parameter(Mandatory)][string]$Selection)
    $valid = $script:RegistryTargets.Index
    $picked = $Selection -split '[,\s]+' | Where-Object { $_ } | ForEach-Object {
        $n = 0; if ([int]::TryParse($_.Trim(), [ref]$n)) { $n } else { -1 }
    }
    $picked | Where-Object { $_ -in $valid } | Sort-Object -Unique
}

function Remove-HelpDeskRegistryData {
    param(
        [Parameter(Mandatory)][string]$ComputerName,
        [Parameter(Mandatory)][pscredential]$Credential,
        [Parameter(Mandatory)][string]$Selection
    )
    $indices = ConvertTo-HelpDeskIndexList -Selection $Selection
    if (-not $indices) {
        return [pscustomobject]@{ Success = $false; Message = 'No valid numbers selected.'; Results = @() }
    }
    $chosen = $script:RegistryTargets | Where-Object { $_.Index -in $indices }
    try {
        $results = Invoke-Command -ComputerName $ComputerName -Credential $Credential -ErrorAction Stop `
            -ArgumentList (,$chosen) -ScriptBlock {
                param($Targets)
                foreach ($t in $Targets) {
                    $full = "Registry::$($t.Hive)\$($t.Path)"
                    $ok = $false; $msg = ''
                    try {
                        if ([string]::IsNullOrWhiteSpace($t.Name)) {
                            if (Test-Path -LiteralPath $full) {
                                Remove-Item -LiteralPath $full -Recurse -Force -ErrorAction Stop
                                $ok = $true; $msg = 'Key deleted'
                            } else { $ok = $true; $msg = 'Key already absent' }
                        }
                        else {
                            Remove-ItemProperty -LiteralPath $full -Name $t.Name -Force -ErrorAction Stop
                            $ok = $true; $msg = 'Value deleted'
                        }
                    }
                    catch { $ok = $false; $msg = $_.Exception.Message }
                    [pscustomobject]@{ Index = $t.Index; Label = $t.Label; Success = $ok; Message = $msg }
                }
            }
        foreach ($r in $results) {
            Write-HelpDeskLog ("DELETE [{0}] {1} -> {2} ({3})" -f $r.Index,$r.Label,$r.Success,$r.Message) `
                ($(if ($r.Success) { 'Info' } else { 'Error' }))
        }
        $all = ($results | Where-Object { -not $_.Success }).Count -eq 0
        if ($all) {
            [pscustomobject]@{ Success = $true;  Message = 'All selected items deleted.'; Results = $results }
        } else {
            [pscustomobject]@{ Success = $false; Message = 'One or more deletions failed.'; Results = $results }
        }
    }
    catch {
        Write-HelpDeskLog "Delete failed on $ComputerName : $($_.Exception.Message)" 'Error'
        [pscustomobject]@{ Success = $false; Message = "Delete failed: $($_.Exception.Message)"; Results = @() }
    }
}

#endregion

#region ---------- 5. Trigger reboot (the "Trigger Reboot" screen) ----------

function Restart-HelpDeskComputer {
    param(
        [Parameter(Mandatory)][string]$ComputerName,
        [Parameter(Mandatory)][pscredential]$Credential,
        [int]$DelaySeconds = 60,
        [string]$UserMessage = 'IT maintenance complete. This PC will restart shortly.'
    )
    try {
        Invoke-Command -ComputerName $ComputerName -Credential $Credential -ErrorAction Stop `
            -ArgumentList $DelaySeconds, $UserMessage -ScriptBlock {
                param($d, $m)
                shutdown.exe /r /t $d /c $m
            }
        Write-HelpDeskLog "Reboot triggered on $ComputerName (delay ${DelaySeconds}s)." 'Info'
        [pscustomobject]@{ Success = $true;  Message = "Reboot triggered on $ComputerName." }
    }
    catch {
        Write-HelpDeskLog "Reboot failed on $ComputerName : $($_.Exception.Message)" 'Error'
        [pscustomobject]@{ Success = $false; Message = "Reboot failed: $($_.Exception.Message)" }
    }
}

#endregion
